---
import type { CollectionEntry } from 'astro:content';
import { formatoPrecio } from '../config';
import { fotoProducto } from '../imagenes';
interface Props { producto: CollectionEntry<'productos'> }
const { producto } = Astro.props;
const p = producto.data;
---
<a class="tarjeta" href={`/${p.categoria}/${p.codigo.toLowerCase()}/`}>
  <div class="tarjeta-foto">
    <img src={fotoProducto(p.codigo, p.fotos[0])} alt={p.nombre} loading="lazy" width="800" height="600" />
    {!p.disponible && <span class="agotado">Agotado</span>}
  </div>
  <h3>{p.nombre}</h3>
  <p class="tarjeta-precio">{formatoPrecio(p.precio)}</p>
</a>

<style>
  .tarjeta { display: block; color: inherit; text-decoration: none; }
  .tarjeta-foto { position: relative; background: var(--piedra); border-radius: 4px; overflow: hidden; aspect-ratio: 4 / 3; }
  .tarjeta-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .agotado { position: absolute; left: .75rem; top: .75rem; background: var(--carbon); color: #fff; font-size: .8125rem; padding: .25rem .625rem; border-radius: 99px; }
  h3 { font-family: var(--f-display); font-weight: 700; font-size: 1.0625rem; line-height: 1.3; margin: .75rem 0 .125rem; }
  .tarjeta:hover h3 { text-decoration: underline; text-decoration-color: var(--ocre); text-underline-offset: 3px; }
  .tarjeta-precio { margin: 0; color: var(--texto-suave); }
</style>
