---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Casa from '../components/Casa.astro';
import ProductoTarjeta from '../components/ProductoTarjeta.astro';
import IconoWhatsApp from '../components/IconoWhatsApp.astro';
import { NEGOCIO, CATEGORIAS, enlaceWhatsApp, mapaEmbed, enlaceComoLlegar } from '../config';

const destacados = (await getCollection('productos', ({ data }) => data.destacado && data.disponible))
  .sort((a, b) => a.data.codigo.localeCompare(b.data.codigo));
---
<Base>
  <section class="portada contenedor">
    <div class="portada-texto">
      <h1>Recámaras y comedores para tu casa</h1>
      <p class="entrada">Mira los modelos, pregúntanos lo que quieras por WhatsApp y te lo llevamos a domicilio.</p>
      <a class="boton boton-whatsapp" href={enlaceWhatsApp('Hola, vi su sitio web y quiero información sobre sus muebles.')} target="_blank" rel="noopener">
        <IconoWhatsApp /> Preguntar por WhatsApp
      </a>
    </div>
    <ul class="portada-casas" role="list">
      {Object.entries(CATEGORIAS).map(([slug, c], i) => (
        <li style={`--i:${i}`}>
          <a href={`/${slug}/`} class="puerta">
            <Casa src={c.portada} posicion={c.portadaPosicion} />
            <span class="puerta-nombre">{c.nombre}</span>
            <span class="puerta-desc">{c.descripcion}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {destacados.length > 0 && (
    <section class="contenedor bloque">
      <h2>Lo más pedido</h2>
      <div class="rejilla-productos">
        {destacados.map((p) => <ProductoTarjeta producto={p} />)}
      </div>
    </section>
  )}

  <section class="contenedor bloque">
    <h2>Así compras con nosotros</h2>
    <ol class="pasos">
      <li><strong>Elige tu mueble</strong> en Recámaras o Comedores.</li>
      <li><strong>Escríbenos por WhatsApp</strong> desde el producto. Te mandamos más fotos y resolvemos tus dudas.</li>
      <li><strong>Te lo llevamos</strong> a tu casa, o pasa a verlo a la tienda.</li>
    </ol>
  </section>

  <section class="contenedor bloque visitanos" id="ubicacion">
    <div class="visitanos-texto">
      <h2>Visita la tienda</h2>
      <p>Ven a ver los muebles en persona y llévatelos o te los mandamos a tu casa.</p>
      <p class="visitanos-datos">{NEGOCIO.direccion}</p>
      <p class="visitanos-referencias">{NEGOCIO.referencias}</p>
      <p class="visitanos-datos">{NEGOCIO.horario.map((h, i) => <>{i > 0 && <br />}{h}</>)}</p>
      <a class="boton boton-borde" href={enlaceComoLlegar()} target="_blank" rel="noopener">Cómo llegar</a>
    </div>
    <div class="mapa">
      <iframe
        src={mapaEmbed()}
        title={`Mapa de ubicación de ${NEGOCIO.nombre}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </section>

  <section class="contenedor bloque">
    <div class="mayoreo">
      <div>
        <h2>¿Tienes una mueblería?</h2>
        <p>También vendemos por mayoreo. Escríbenos y te pasamos condiciones y catálogo.</p>
      </div>
      <a class="boton boton-borde" href={enlaceWhatsApp('Hola, tengo una mueblería y me interesa comprar por mayoreo.')} target="_blank" rel="noopener">
        Pedir precios de mayoreo
      </a>
    </div>
  </section>
</Base>

<style>
  .portada {
    display: grid; gap: 2.5rem; align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5rem) 1rem;
  }
  @media (min-width: 56rem) { .portada { grid-template-columns: 5fr 7fr; gap: 3rem; } }
  .entrada { font-size: 1.1875rem; color: var(--texto-suave); max-width: 32ch; margin: 0 0 1.75rem; }

  .portada-casas { list-style: none; margin: 0; padding: 2rem .75rem 0; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3rem); }
  .puerta { display: block; color: inherit; text-decoration: none; }
  .puerta-nombre {
    display: block; margin-top: 1rem;
    font-family: var(--f-display); font-weight: 800; font-size: clamp(1.25rem, 3vw, 1.75rem); line-height: 1.1;
  }
  .puerta-desc { display: block; color: var(--texto-suave); font-size: .9375rem; margin-top: .25rem; }
  .puerta :global(.casa) { transition: transform .35s ease; }
  .puerta:hover :global(.casa) { transform: translateY(-6px); }
  .puerta:hover .puerta-nombre { text-decoration: underline; text-decoration-color: var(--ocre); text-decoration-thickness: 3px; text-underline-offset: 5px; }

  /* Único momento animado: las dos casas se levantan al cargar. */
  @keyframes levantar { from { opacity: 0; transform: translateY(24px); } }
  .portada-casas li { animation: levantar .7s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--i) * 140ms + 100ms); }

  .bloque { margin-top: clamp(3.5rem, 8vw, 6rem); }

  .pasos { list-style: none; counter-reset: paso; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 1.5rem; }
  @media (min-width: 48rem) { .pasos { grid-template-columns: repeat(3, 1fr); gap: 2rem; } }
  .pasos li { counter-increment: paso; padding-top: 1rem; border-top: 3px solid var(--ocre); max-width: 34ch; }
  .pasos li::before { content: counter(paso); display: block; font-family: var(--f-display); font-weight: 800; font-size: 2rem; line-height: 1; color: var(--ocre); margin-bottom: .5rem; }
  .pasos strong { font-family: var(--f-display); display: block; font-size: 1.125rem; color: var(--carbon); }

  .visitanos { display: grid; gap: 1.5rem; align-items: center; }
  @media (min-width: 52rem) { .visitanos { grid-template-columns: 5fr 7fr; gap: 3rem; } }
  .visitanos-texto p { color: var(--texto-suave); max-width: 40ch; }
  .visitanos-datos { color: var(--texto) !important; font-weight: 500; margin-bottom: .5rem; }
  .visitanos-referencias { font-size: .9375rem; margin: 0 0 1rem; }
  .visitanos-datos:last-of-type { margin-bottom: 1.5rem; }
  .mapa { border-radius: 4px; overflow: hidden; border: 1px solid var(--linea); background: var(--piedra); aspect-ratio: 4 / 3; }
  @media (min-width: 52rem) { .mapa { aspect-ratio: 16 / 10; } }
  .mapa iframe { display: block; width: 100%; height: 100%; border: 0; }

  .mayoreo { background: var(--piedra); border-radius: 4px; padding: clamp(1.5rem, 4vw, 2.5rem); display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: space-between; }
  .mayoreo p { margin: 0; color: var(--texto-suave); max-width: 46ch; }
</style>
