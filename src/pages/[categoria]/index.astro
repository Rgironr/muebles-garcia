---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductoTarjeta from '../../components/ProductoTarjeta.astro';
import IconoWhatsApp from '../../components/IconoWhatsApp.astro';
import { CATEGORIAS, enlaceWhatsApp, type Categoria } from '../../config';

export function getStaticPaths() {
  return Object.keys(CATEGORIAS).map((categoria) => ({ params: { categoria } }));
}

const categoria = Astro.params.categoria as Categoria;
const info = CATEGORIAS[categoria];
// Primero los disponibles, luego los agotados; dentro de cada grupo por código.
const productos = (await getCollection('productos', ({ data }) => data.categoria === categoria))
  .sort((a, b) => Number(b.data.disponible) - Number(a.data.disponible) || a.data.codigo.localeCompare(b.data.codigo));
---
<Base titulo={info.nombre} descripcion={`${info.nombre} en Muebles García. ${info.descripcion} Pide por WhatsApp.`} imagen={info.portada}>
  <div class="contenedor">
    <header class="cabecera">
      <h1>{info.nombre}</h1>
      <p>{info.descripcion}</p>
    </header>

    {productos.length > 0 ? (
      <div class="rejilla-productos">
        {productos.map((p) => <ProductoTarjeta producto={p} />)}
      </div>
    ) : (
      <div class="vacio">
        <p>Estamos subiendo los modelos de {info.nombre.toLowerCase()}. Pregúntanos por WhatsApp qué tenemos hoy en tienda.</p>
        <a class="boton boton-whatsapp" href={enlaceWhatsApp(`Hola, ¿qué modelos de ${info.nombre.toLowerCase()} tienen disponibles?`)} target="_blank" rel="noopener">
          <IconoWhatsApp /> Preguntar por WhatsApp
        </a>
      </div>
    )}
  </div>
</Base>

<style>
  .cabecera { padding-block: clamp(2rem, 5vw, 3.5rem) 2rem; border-bottom: 1px solid var(--linea); margin-bottom: 2rem; }
  .cabecera h1 { margin-bottom: .5rem; }
  .cabecera p { margin: 0; color: var(--texto-suave); max-width: 50ch; font-size: 1.125rem; }
  .vacio p { max-width: 50ch; }
</style>
